# PostgreSQL
POSTGRES_DB=agua_pura
POSTGRES_USER=agua_pura_app
POSTGRES_PASSWORD=
# Puerto local opcional para conectar DataGrip; solo se publica en 127.0.0.1.
POSTGRES_HOST_PORT=15432

# Backend
JWT_ISSUER=agua-pura-local
# Base64 de al menos 32 bytes aleatorios. Debe generarse para cada instalacion.
JWT_SECRET_BASE64=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
STORAGE_PATH=/app/storage

# Bootstrap inicial. Se usa una sola vez si no existen usuarios.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FORCE_PASSWORD_CHANGE=true

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api

# Produccion HTTPS (se usan con docker-compose.prod.yml)
PUBLIC_ORIGIN=https://agua.example.com:8443
HTTP_PORT=8080
HTTPS_PORT=8443
TLS_CERT_PATH=
TLS_KEY_PATH=

