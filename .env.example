# PostgreSQL
POSTGRES_DB=agua_pura
POSTGRES_USER=agua_pura_app
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_ISSUER=agua-pura-local
# Base64 de al menos 32 bytes aleatorios. Ejemplo solo para desarrollo; reemplazar siempre.
JWT_SECRET_BASE64=Y2hhbmdlLXRoaXMtZGV2ZWxvcG1lbnQtc2VjcmV0LWtleS0xMjM0NTY3ODkw
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
STORAGE_PATH=/app/storage

# Bootstrap inicial. Se usa una sola vez si no existen usuarios.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_FORCE_PASSWORD_CHANGE=true

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api

# FEL permanece desactivado hasta contratar un proveedor real.
FEL_ENABLED=false
FEL_PROVIDER_CODE=
FEL_CREDENTIAL_SECRET_REF=
