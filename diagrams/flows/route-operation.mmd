flowchart LR
    Config["Configurar empresa, catálogo y precios"] --> Staff["Crear vendedor, vehículo, ruta y clientes"]
    Staff --> Prepare["Bodega prepara carga"]
    Prepare --> Warehouse["Bodega confirma entrega"]
    Warehouse --> Seller["Vendedor confirma recepción"]
    Seller --> Start["Iniciar recorrido\n(GPS: Inicio)"]
    Start --> Operate["Ventas, pagos, mermas y devoluciones\n(GPS: Venta por cada confirmación)"]
    Operate --> NoSale["Visita sin compra\n(GPS + motivo ético)"]
    NoSale --> Operate
    Operate --> Return["Bodega recibe producto no vendido y devoluciones"]
    Return --> Cash["Registrar entrega de efectivo"]
    Cash --> Settle["Conciliar inventario y dinero"]
    Settle --> Closed["Cerrar liquidación y carga"]
    Closed --> Map["Historial geográfico disponible\n(Leaflet + OpenStreetMap + OSRM)"]
