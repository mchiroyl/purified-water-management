    IDB_PRESENTATION ||--o{ IDB_SPECIAL_PRICE : applies
    IDB_ROUTE_PACKAGE ||--o{ IDB_ROUTE_INVENTORY : snapshots
    IDB_PRODUCT ||--o{ IDB_ROUTE_INVENTORY : balances
    IDB_ROUTE_PACKAGE ||--o{ IDB_LOCAL_SALE : records
    IDB_CUSTOMER o|--o{ IDB_LOCAL_SALE : permanent_buyer
    IDB_PROVISIONAL_CUSTOMER o|--o{ IDB_LOCAL_SALE : provisional_buyer
    IDB_LOCAL_SALE ||--|{ IDB_LOCAL_SALE_ITEM : contains
    IDB_PRESENTATION ||--o{ IDB_LOCAL_SALE_ITEM : sold_as
    IDB_LOCAL_SALE ||--|{ IDB_LOCAL_PAYMENT : paid_by
    IDB_ROUTE_PACKAGE ||--o{ IDB_LOCAL_WASTE : reports
    IDB_LOCAL_WASTE ||--|{ IDB_LOCAL_WASTE_ITEM : contains
    IDB_PRESENTATION ||--o{ IDB_LOCAL_WASTE_ITEM : damaged_as
    IDB_LOCAL_WASTE ||--o{ IDB_LOCAL_WASTE_EVIDENCE : evidences
    IDB_FILE_CACHE ||--o{ IDB_LOCAL_WASTE_EVIDENCE : stores_blob
    IDB_ROUTE_PACKAGE ||--o{ IDB_LOCAL_RETURN : reports
    IDB_LOCAL_RETURN ||--|{ IDB_LOCAL_RETURN_ITEM : contains
    IDB_PRESENTATION ||--o{ IDB_LOCAL_RETURN_ITEM : returned_as
    IDB_PROVISIONAL_CUSTOMER ||--o| IDB_OUTBOX_OPERATION : create_operation
    IDB_LOCAL_SALE ||--o| IDB_OUTBOX_OPERATION : sale_operation
    IDB_LOCAL_PAYMENT ||--o| IDB_OUTBOX_OPERATION : payment_operation
    IDB_LOCAL_WASTE ||--o| IDB_OUTBOX_OPERATION : waste_operation
    IDB_LOCAL_RETURN ||--o| IDB_OUTBOX_OPERATION : return_operation
    IDB_OUTBOX_OPERATION ||--o| IDB_SYNC_RESULT : produces
